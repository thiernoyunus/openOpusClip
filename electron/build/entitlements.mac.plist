<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Electron's V8 needs to generate and run code at runtime. Without these
         three, the hardened runtime kills the renderer on launch. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- The app spawns a bundled Python backend and a Node renderer, which read
         DYLD_* / PYTHONHOME-style variables set in their environment. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Outbound: YouTube downloads, Gemini/ElevenLabs APIs, S3 uploads.
         Inbound: the local backend (127.0.0.1:8000) and renderer (3100) that
         the app window itself connects to. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Users pick local video files to process. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
