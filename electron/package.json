{
  "name": "openopusclip-desktop",
  "version": "1.0.16",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:telemetry": "node telemetry.selfcheck.js",
    "test:updater": "node updater.selfcheck.js",
    "test:telemetry:live": "electron posthog-live-smoke.js",
    "package": "electron-builder --mac dir --arm64",
    "package:arm64": "electron-builder --mac dmg zip --arm64",
    "package:x64": "electron-builder --mac dmg zip --x64",
    "package:both": "electron-builder --mac dmg zip --arm64 --x64",
    "package:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "posthog-node": "^5.50.0"
  },
  "description": "AI-powered vertical video generator",
  "author": "Thierno Yunus Diallo <youndiallo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thiernoyunus/openOpusClip.git"
  }
}
