# Video files
*.mp4
*.webm
*.mov
*.mkv
# ...except landing-page hero assets, which the site needs at runtime
!dashboard/public/landing/*.mp4

# YOLO model
*.pt

# Python virtual environment
.venv/
__pycache__/
*.pyc

# Temporary files / runtime dirs
temp_*
uploads/
downloads/
videos/
output/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Secrets
.env

# Generated metadata
*_metadata.json

# Cache dirs
.cache/
.config/
# Multi-agent Skills
.agents/
.agent/
.claude/
skills/
skills-lock.json

# Electron shell
electron/node_modules/
electron/dist/

# Desktop packaging (Step A): staged runtime + download cache
desktop-stage/
desktop-stage-x64/
.desktop-build-cache/

# Code-signing material. The private key and .p12 must NEVER be committed:
# together with the public cert they are the full Developer ID signing identity,
# and anyone with them can ship software as this developer. They live in the
# login keychain; these files are only a local backup.
electron/certs/
*.p12
*.key
*.csr
