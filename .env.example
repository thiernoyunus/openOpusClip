# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# --- Performance knobs (defaults are laptop-safe; raise them on big machines) ---

# How many videos can process at the same time. 1 = laptop-safe default.
# On a server with lots of RAM/cores, try 4-5.
# MAX_CONCURRENT_JOBS=1

# How many clips within one job process in parallel. 1 = one at a time (default).
# Each extra worker runs its own ffmpeg + face detection, so 2-4 only on machines
# with RAM to spare.
# OPENSHORTS_CLIP_WORKERS=1

# Keep a copy of the full original video with each job (needed for the editor's
# "Extend clip" feature). Set to 0 to save disk space if you don't use Extend.
# OPENSHORTS_KEEP_ORIGINAL=1

# Use the Mac's dedicated video chip for encoding (much faster). Ignored on
# Windows/Linux for now. Set to 0 to force software encoding.
# OPENSHORTS_HWACCEL=1

# Fall back to a heavier AI model (YOLO) when face detection fails. Off by
# default; turning it on needs the full ML install (torch).
# ENABLE_YOLO_FALLBACK=false

# How many browser tabs the exporter uses to capture frames. Default = half
# your CPU cores. Raise on a dedicated render box, lower to 1-2 on weak laptops.
# RENDER_CONCURRENCY=2

# How many exports can run at once. 1 (default) prevents export pile-ups from
# freezing the machine; extra exports wait in line.
# MAX_RENDER_JOBS=1

# Export encoding speed/quality tradeoff: ultrafast, veryfast, faster (default),
# fast, medium. Faster presets = quicker exports, slightly larger files.
# RENDER_X264_PRESET=faster

# Auto-delete finished projects older than this many seconds. 0 (default) keeps
# them forever. Uncomment for dev machines with small disks (86400 = 1 day).
# JOB_RETENTION_SECONDS=86400
